node_modules/
.local-backups/
.DS_Store
*.log

# The Arc21 working copy is the system under test, not part of this repository.
# It is a local copy of a separate repo and is deliberately not vendored here.
arc21 copy/

# The project brief is the governing requirements document, and it also contains
# the author's job-application strategy and personal career notes. Held out of
# version control until the author decides whether this repository will be
# published. Adding it later is trivial; removing it from history is not.
PROJECT_BRIEF.md

# The author's personal résumé and job-application handoff notes. Kept out of version
# control for the same reason as the brief; ignored so that it cannot be committed by accident.
Attest RESUME_HANDOFF.md

# Plumbing smoke runs of the WP3 executor. NOT evidence (see src/wp3-execute-run.ts);
# kept out of version control so a smoke record can never be mistaken for a WP3 result.
.smoke/

# WP4 schema states reconstructed from Arc21's history (git archive) or copied
# from the working tree, rebuilt from in disposable runs. Scratch, not evidence;
# the evidence is what each run writes under evidence/runs/.
.wp4-states/
.presentation-captures/
