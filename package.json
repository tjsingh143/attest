{
  "name": "attest-control-assurance",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Attest \u2014 an access control assurance harness for a PostgreSQL row-level-security application. Reads controls from the system catalogs, tests them under role-scoped sessions, and emits timestamped evidence.",
  "engines": {
    "node": ">=23.6"
  },
  "scripts": {
    "attest": "node src/cli.ts",
    "bringup": "node src/cli.ts bringup",
    "inventory": "node src/cli.ts inventory",
    "typecheck": "tsc --noEmit",
    "rubric": "node src/cli.ts rubric",
    "risk-inputs": "node src/cli.ts risk-inputs",
    "score": "node src/cli.ts score",
    "plan-wp3": "node src/cli.ts plan-wp3",
    "seed-extensions": "node src/cli.ts seed-extensions",
    "draft-intents": "node src/cli.ts draft-intents",
    "preflight-wp3": "node src/cli.ts preflight-wp3",
    "prove-gates": "node src/cli.ts prove-gates",
    "execute-wp3": "node src/cli.ts execute-wp3"
  },
  "dependencies": {
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "typescript": "^5.9.0"
  }
}
